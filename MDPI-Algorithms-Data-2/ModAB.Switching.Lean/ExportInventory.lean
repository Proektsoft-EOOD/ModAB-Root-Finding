private def directRefs (info : ConstantInfo) : Array Name :=
  info.type.getUsedConstants ++ (info.value?.map Expr.getUsedConstants).getD #[]
private partial def authoredRefs (env : Environment) (authored : NameSet)
    (seen : NameSet) (n : Name) : NameSet := Id.run do
  if seen.contains n then return {}
  if authored.contains n then return ({} : NameSet).insert n
  if !(n.toString.startsWith "ModAB." || n.toString.startsWith "_private.ModAB.") then return {}
  let some info := env.find? n | return {}
  let mut result : NameSet := {}
  for d in directRefs info do
    for r in (authoredRefs env authored (seen.insert n) d).toArray do
      result := result.insert r
  return result
