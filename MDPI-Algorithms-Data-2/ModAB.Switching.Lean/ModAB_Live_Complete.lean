theorem bpow_natCast (exponent : Nat) :
    bpow (exponent : Int) = (2 : ℝ) ^ exponent := by
  rw [← Int.ofNat_eq_natCast]
  simpa [pow2_eq_two_pow] using bpow_ofNat exponent

