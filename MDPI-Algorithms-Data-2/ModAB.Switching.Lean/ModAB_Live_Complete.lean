              (i - spec.mantissaBitsWithoutImplicit) = i := by
        omega
      simp [hmantissa, hexponent, unpackExponent, hindex]
    · have hsign :
          i = spec.mantissaBitsWithoutImplicit + spec.exponentBits := by
        omega
      subst i
      simp [unpackSign]

