      | _, _, _ => none := by
  unfold fmaFinite?
  rw [toDyadic_eq, toDyadic_eq, toDyadic_eq]
  cases hx : Model.toDyadic? x <;>
    cases hy : Model.toDyadic? y <;>
    cases hz : Model.toDyadic? z <;>
