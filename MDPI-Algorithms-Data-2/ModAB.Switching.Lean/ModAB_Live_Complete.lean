    n = (Nat.sqrt n / d * (Nat.sqrt n / d)) * (d * d) ↔
      n = Nat.sqrt n * Nat.sqrt n ∧ Nat.sqrt n % d = 0 := by
  have hmul : (Nat.sqrt n / d * (Nat.sqrt n / d)) * (d * d) =
