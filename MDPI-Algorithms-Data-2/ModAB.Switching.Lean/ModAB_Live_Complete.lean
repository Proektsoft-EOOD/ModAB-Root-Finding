    (hyExponent : yExponent ≠ 0)
    (hzExponent : zExponent ≠ 0)
    (hxMantissa : xMantissa ≠ 0)
    (hyMantissa : yMantissa ≠ 0)
    (hzMantissa : zMantissa ≠ 0)
    (hsign : Bool.xor xSign ySign ≠ zSign)
    (haligned :
      (xExponent - 1) + (yExponent - 1) + 52 =
        (zExponent - 1) + 1074)
