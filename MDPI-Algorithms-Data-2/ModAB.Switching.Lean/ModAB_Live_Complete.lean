theorem toDyadic?_ofFields_of_isFinite
    (fmt : FloatFormat) (sign : Bool) (exponent fraction : Nat)
    (hexponent : exponent < 2 ^ fmt.expWidth)
    (hfraction : fraction < 2 ^ fmt.fracWidth)
