  have hbits :
      toModelBits (ofFields fmt (signBit x) (expField x) (fracField x)) =
        toModelBits x := by
    rw [toModelBits_ofFields]
    have hsign :
        modelSign (signBit x) =
          Sign.ofBitVec (unpackSign (toModelBits x)) := by
      rw [← modelSignBit_ofBitVec_unpackSign]
