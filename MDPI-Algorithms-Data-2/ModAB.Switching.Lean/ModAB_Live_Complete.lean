@[csimp] theorem bias_eq_biasImpl :
    bias = biasImpl := by
  funext fmt
  simp [bias, biasImpl, Nat.shiftLeft_eq]

/-- Compiler substitution for the least-subnormal dyadic exponent. -/
@[csimp] theorem ieeeMinSubnormalExponent_eq_ieeeMinSubnormalExponentImpl :
