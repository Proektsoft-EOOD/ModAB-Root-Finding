    · by_cases hlt : left < right
      · have hsumPos : 0 < -(left : Int) + (right : Int) := by omega
        have hsumNe : -(left : Int) + (right : Int) ≠ 0 := by omega
        have hle : left ≤ right := Nat.le_of_lt hlt
        have hnatAbs :
