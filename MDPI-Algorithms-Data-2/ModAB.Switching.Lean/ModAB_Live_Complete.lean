/-- Deterministic IEEE-754 rounding-direction attribute. -/
inductive IEEERoundingMode where
  /-- Round to the nearest representable value, breaking ties toward an even significand. -/
  | nearestEven
  /-- Round toward zero. -/
  | towardZero
