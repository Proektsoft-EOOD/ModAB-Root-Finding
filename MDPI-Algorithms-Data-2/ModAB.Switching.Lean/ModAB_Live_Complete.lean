  rw [show exactExtendedMantissa n >>> (shift + 1) =
      ExtendedMantissa.shiftRightOne (exactExtendedMantissa n >>> shift) by rfl]
  simp only [ExtendedMantissa.shiftRightOne]
  rw [exactExtendedMantissa_shift_mantissa]

