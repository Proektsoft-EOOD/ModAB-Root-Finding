    FiniteScaleAdd.roundSum fmt (finiteScaleOffset fmt)
      x.sign y.sign x.mantissa (scale x.exponent)
      y.mantissa (scale y.exponent)
  else
    roundDyadicImpl fmt <| addDyadic (x.toDyadic fmt) (y.toDyadic fmt)

