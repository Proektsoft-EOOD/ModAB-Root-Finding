    ErrorBounds.relativeError x (round (β := β) (fexp := flxExp prec) rnd x) hx ≤
        ulp β (flxExp prec) x / (2 * abs x) :=
      ErrorBounds.relative_error_round_ulp rnd x hx
    _ = (ulp β (flxExp prec) x / abs x) / 2 := by
      field_simp [abs_ne_zero.mpr hx]
