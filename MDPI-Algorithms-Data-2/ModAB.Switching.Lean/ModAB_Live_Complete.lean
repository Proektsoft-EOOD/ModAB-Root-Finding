        if sign then 0x80000000 else 0
      else if fraction == 0x800000 then
        mkBits sign 1 0
      else
        mkBits sign 0 fraction.toNat
    else
      let roundedMantissa :=
        if leading < 23 then
          product <<< (23 - leading)
        else
          FloatLib.Numerics.FixedWord.roundShiftRightEven product (leading - 23).toNat
