/-! ## Exact reconstruction of finite representations -/

/-- A nonzero decoded dyadic already uses the format's canonical exponent. -/
theorem cexp_toDyadic? {fmt : FloatFormat} {x : Model fmt} {d : Numerics.Dyadic}
