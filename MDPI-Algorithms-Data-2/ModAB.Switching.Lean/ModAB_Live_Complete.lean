def sqrtRem (value : Nat) : Nat × Nat :=
  match checkRoot? value (approxRoot value (value.log2 / 2)) with
  | some result => result
  | none =>
      let root :=
        if value ≤ 1 then value else Nat.sqrt.iter value (1 <<< (value.log2 / 2 + 1))
