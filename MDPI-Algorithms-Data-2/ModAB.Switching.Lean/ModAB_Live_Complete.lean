  simp [ieeeMaxNormalExponent, ieeeMaxNormalExponentImpl, bias, biasImpl,
    Nat.shiftLeft_eq]

/-- Compiler substitution for the least normal unbiased exponent. -/
@[csimp] theorem ieeeMinNormalExponent_eq_ieeeMinNormalExponentImpl :
