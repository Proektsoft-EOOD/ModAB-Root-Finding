  · rw [hround]
    by_cases hnormal : pow2 fmt.fracWidth ≤ rounded
    · rw [ite_eq_left hnormal]
      exact isFinite_ofFields_minNormal fmt hfmt
    · rw [ite_eq_right hnormal]
