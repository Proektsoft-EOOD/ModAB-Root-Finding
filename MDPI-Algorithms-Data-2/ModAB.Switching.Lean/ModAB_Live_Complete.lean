theorem eq_of_toDyadic?_eq_some {fmt : FloatFormat} {x y : Model fmt}
    {d : Numerics.Dyadic} (hx : toDyadic? x = some d) (hy : toDyadic? y = some d) :
    x = y := by
  have hsign : signBit x = signBit y :=
    (sign_eq_signBit_of_toDyadic?_some hx).symm.trans
