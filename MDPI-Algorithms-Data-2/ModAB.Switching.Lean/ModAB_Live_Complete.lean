      2 ^ fmt.fracWidth ≤ den.toNat ∧ den.toNat < 2 ^ (fmt.fracWidth + 1) :=
    normalMantissa_bounds h (fracHigh fmt (toWords y).hi) (toWords y).lo
      (fracHigh_lt h (toWords y).hi)
