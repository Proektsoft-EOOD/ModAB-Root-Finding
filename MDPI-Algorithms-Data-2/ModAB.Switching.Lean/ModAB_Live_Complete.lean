  rw [decode_of_normalExponent h x hxZero hxExceptional,
    decode_of_normalExponent h y hyZero hyExceptional]
  simp only [Bool.or_eq_true, beq_iff_eq, hxMantissaNe, hyMantissaNe, or_self, ↓reduceIte,
