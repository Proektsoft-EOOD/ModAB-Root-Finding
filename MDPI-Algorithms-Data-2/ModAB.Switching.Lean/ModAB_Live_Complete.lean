      hExp, hFrac, hSign, hnotAllOnes, FloatFormat.ieeeMinSubnormalExponent,
      FloatFormat.ieeeNormalMantissaExpOffset, FloatFormat.minSubnormalExponent,
      FloatFormat.minNormalExponent, hbias, sub_sub]
