      · have hrightLt : right < left := by omega
        have hsumNeg : -(left : Int) + (right : Int) < 0 := by omega
        have hsumNe : -(left : Int) + (right : Int) ≠ 0 := by omega
        have hnatAbs :
            (-(left : Int) + (right : Int)).natAbs = left - right := by
          have hsumEq :
