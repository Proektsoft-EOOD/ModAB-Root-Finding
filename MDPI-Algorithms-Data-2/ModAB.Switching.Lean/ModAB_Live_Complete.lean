    quotCeil numerator denominator ≤ numerator / denominator + 1 := by
  by_cases hdenominator : denominator = 0
  · simp [hdenominator, quotCeil]
  · by_cases hremainder : numerator % denominator = 0
    · simp [quotCeil, hdenominator, hremainder]
    · simp [quotCeil, hdenominator, hremainder]

