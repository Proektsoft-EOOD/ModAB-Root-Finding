      · rw [show copySign magnitude signSource = toggleSign magnitude by
          simp [copySign, hencoding, FloatFormat.supportsSignedZero, hsign]]
        simp [isInf, hencoding]
  | finiteMaxNaN | finite | finiteUnsignedZero =>
