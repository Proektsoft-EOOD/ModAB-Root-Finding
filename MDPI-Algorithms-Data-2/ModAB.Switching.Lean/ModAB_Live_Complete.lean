    (x y : Model fmt) : Option (Model fmt) :=
  withFinite? x fun xSign xExponent xMantissa =>
    withFinite? y fun ySign yExponent yMantissa =>
      some <| divFields fmt
        xSign xExponent xMantissa ySign yExponent yMantissa

