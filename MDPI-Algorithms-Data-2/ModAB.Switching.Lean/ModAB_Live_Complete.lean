  let signBits : UInt32 := if sign then (1 : UInt32) <<< 31 else 0
  let exponentBits : UInt32 := (UInt32.ofNat exponent &&& 0xff) <<< 23
  let fractionBits : UInt32 := UInt32.ofNat fraction &&& 0x007fffff
