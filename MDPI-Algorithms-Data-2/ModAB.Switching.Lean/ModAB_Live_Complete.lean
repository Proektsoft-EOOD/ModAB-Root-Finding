theorem normalComponents_toDyadic
    (sign : Bool) (exponent mantissa : Nat)
    (hexponent : exponent ≠ 0) (hmantissa : mantissa ≠ 0) :
    FiniteKernel.Components.toDyadic FloatFormat.binary64 {
        sign
        exponent
