      (normalMantissa fmt (fracHigh fmt (toWords y).hi) (toWords y).lo).toNat ≠ 0 :=
    Nat.ne_of_gt (lt_of_lt_of_le (Nat.two_pow_pos _) hyMantissaBounds.1)
