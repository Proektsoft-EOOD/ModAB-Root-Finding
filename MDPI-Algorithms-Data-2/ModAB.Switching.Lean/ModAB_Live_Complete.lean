      rw [bpow_negSucc, ← div_eq_inv_mul, div_le_iff₀ (by rw [pow2_eq_two_pow]; positivity)]
      simp only [Numerics.RationalBinary.atLeastPowerOfTwo, decide_eq_true_eq, pow2_eq_two_pow,
        ge_iff_le]
