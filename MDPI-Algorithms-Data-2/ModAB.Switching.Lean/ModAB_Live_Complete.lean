    have hle : (p11.hi.toNat + carry2.toNat) * 2 ^ 192 ≤ x.toNat * y.toNat := by
      rw [hcolumns]
      exact Nat.le_add_left _ _
    have hlt : (p11.hi.toNat + carry2.toNat) * 2 ^ 192 < 2 ^ 64 * 2 ^ 192 :=
      calc (p11.hi.toNat + carry2.toNat) * 2 ^ 192 ≤ x.toNat * y.toNat := hle
