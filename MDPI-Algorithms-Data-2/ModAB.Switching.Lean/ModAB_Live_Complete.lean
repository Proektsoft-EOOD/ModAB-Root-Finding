@[simp] theorem unpackedToReal_zero (sign : Float.Model.UnpackedFloat.Sign) :
    unpackedToReal (.zero sign) = 0 := by
  cases sign <;>
    simp [unpackedToReal, unpackedToDyadic?, Numerics.Dyadic.toReal,
      Numerics.Dyadic.signedSignificand]

