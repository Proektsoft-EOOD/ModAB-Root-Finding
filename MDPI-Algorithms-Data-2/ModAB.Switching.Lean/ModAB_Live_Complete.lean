  have hd : 0<D := endpoint_difference_pos hs
  have hv : v ∈ Set.Icc (0:ℝ) (1/2) := ratio_range hs
  have hDH : D≤H := le_max_left _ _
  have hzH : |f3|≤H := le_max_right _ _
