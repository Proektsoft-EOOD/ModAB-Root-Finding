def dyadicNearestEvenOverflows (fmt : FloatFormat) (exact : Numerics.Dyadic) : Bool :=
  match cmpDyadic { exact with negative := false } (overflowMidpoint fmt) with
  | .gt => true
  | .eq => maxFiniteMantissaOdd fmt
  | .lt => false

