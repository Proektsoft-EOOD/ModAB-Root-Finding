  have hFrac := fracField_ofFields_of_lt fmt sign exponent fraction hfraction
  cases hencoding : fmt.encoding
  · simp [isFinite, hencoding, IEEE.isFinite, hExp]
  · simp [isFinite, isNaN, hencoding, hExp, hFrac]
