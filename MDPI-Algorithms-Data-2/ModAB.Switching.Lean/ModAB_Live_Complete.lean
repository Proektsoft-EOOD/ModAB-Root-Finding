  · have hmax :
        Numerics.RationalBinary.floorLog2 numerator denominator + exponent ≤
          fmt.maxNormalExponent :=
      le_of_not_gt hoverflow
    by_cases hunderflow :
        Numerics.RationalBinary.floorLog2 numerator denominator + exponent <
          fmt.minSubnormalExponent
    · exact Or.inr
