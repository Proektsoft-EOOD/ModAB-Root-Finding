    rw [Nat.shiftLeft_eq]
    norm_num at hroot ⊢
    omega
  have hrootShiftOneFit : state.root.toNat <<< 1 < 2 ^ 128 := by
    rw [Nat.shiftLeft_eq]
    norm_num at hroot ⊢
    omega
  have hremainderShiftTwoFit :
