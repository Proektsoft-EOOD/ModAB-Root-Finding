    (hcarry : (add128 x y).carry = 0) :
    (add128 x y).value.toNat = x.toNat + y.toNat := by
  have hexact := add128_toNat x y
  dsimp only at hexact ⊢
  simp [hcarry] at hexact
  exact hexact

/--
