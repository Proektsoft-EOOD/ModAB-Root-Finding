  have hcolumns : x.toNat * y.toNat =
      p00.lo.toNat + second1.value.toNat * 2 ^ 64 + third2.value.toNat * 2 ^ 128 +
        (p11.hi.toNat + carry2.toNat) * 2 ^ 192 := by
    rw [hexpand, hcarry2]
