            by_cases hxzero : dx.significand = 0
            · simp only [hxzero, ite_eq_left]
              exact congrArg some (ofUInt32_signedZero (Bool.xor dx.negative dy.negative))
            · simp only [hxzero, ite_false, ofUInt32_roundRatScaled]

