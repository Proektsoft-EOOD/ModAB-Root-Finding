    let shift := numLog - denLog
    let initial := Int.ofNat shift
    if num < den <<< UInt64.ofNat shift then initial - 1 else initial
  else
    let shift := denLog - numLog
    let initial := -Int.ofNat shift
    if num <<< UInt64.ofNat shift < den then initial - 1 else initial

