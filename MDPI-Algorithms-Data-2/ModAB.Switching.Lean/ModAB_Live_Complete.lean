@[simp, grind =] theorem toRat_toCore (value : Dyadic) :
    value.toCore.toRat = value.toRat := by
  simp only [toCore, _root_.Dyadic.toRat_ofIntWithPrec_eq_mul_two_pow, neg_neg,
    toRat, Rat.ofInt_eq_cast]

