      2 ^ (FloatFormat.toModel fmt).exponentBits ≤
        (exponent + (FloatFormat.toModel fmt).exponentBias +
          (FloatFormat.toModel fmt).mantissaBitsWithoutImplicit).toNat + 1 :=
