@[inline] def roundEvenScaled (num den : Nat) : Int → Nat
  | .ofNat shift => roundEvenDoubled (num <<< (shift + 1)) den
  | .negSucc shift => roundEvenDoubled (num <<< 1) (den <<< (shift + 1))

