        em.mantissa % 2 ^ k + 2 ^ k * (em.mantissa / 2 ^ k % 2) := by
      rw [Nat.mod_mul]
    have hz : em.mantissa % (2 ^ k * 2) = 0 ↔
        em.mantissa % 2 ^ k = 0 ∧ em.mantissa / 2 ^ k % 2 = 0 := by
      rw [hmod, Nat.add_eq_zero_iff]
      simp
    apply Bool.eq_iff_iff.mpr
    simp [hz]
    tauto

