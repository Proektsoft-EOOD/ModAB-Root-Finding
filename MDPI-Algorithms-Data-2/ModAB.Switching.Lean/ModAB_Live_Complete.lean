    ofFields fmt true 0 0 = negZero fmt := by
  have hzero : FloatFormat.ofWordNat fmt 0 = 0 := by
    unfold FloatFormat.ofWordNat
    simp
  unfold ofFields mkBits negZero ofBits
  simp [hzero]

