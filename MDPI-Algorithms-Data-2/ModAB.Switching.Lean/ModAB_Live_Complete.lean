      omega
    simp only [hlogs, ite_false]
    have hdifference :
        Int.ofNat num.log2.toNat - Int.ofNat den.log2.toNat =
          -Int.ofNat (den.log2.toNat - num.log2.toNat) := by
      change (num.log2.toNat : Int) - den.log2.toNat =
        -(den.log2.toNat - num.log2.toNat : Nat)
