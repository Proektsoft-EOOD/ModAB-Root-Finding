  split_ifs <;>
    simp [ofUInt32_posZero, ofUInt32_negZero, ofUInt32_posInf,
      ofUInt32_negInf, ofUInt32_canonicalNaN, ofUInt32_mkBits]
  split <;>
    rw [binary32_fracWidth, binary32_subnormalAlignExp] <;>
    simp_all [ofUInt32_mkBits]

