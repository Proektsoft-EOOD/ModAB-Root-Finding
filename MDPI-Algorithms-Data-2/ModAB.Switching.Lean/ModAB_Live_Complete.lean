    have hdifference :
        Int.ofNat num.log2.toNat - Int.ofNat den.log2.toNat =
          Int.ofNat (num.log2.toNat - den.log2.toNat) := by
      simpa using (Int.ofNat_sub hlogs).symm
    rw [hdifference]
    split <;> omega
