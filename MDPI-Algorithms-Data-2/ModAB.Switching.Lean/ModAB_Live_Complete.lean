    simp only [hfinite, Bool.not_true, beq_iff_eq]
    by_cases hexponent : expField x = 0
    · by_cases hfraction : fracField x = 0
      · simp [hexponent, hfraction]
      · simp [hexponent, hfraction]
    · have hpow : pow2 fmt.fracWidth ≠ 0 := by
        simp [pow2_eq_two_pow]
      simp [hexponent, hpow]
