          if fraction == 0 then
            some ({ negative := sign, significand := 0, exponent := 0 } : Numerics.Dyadic)
          else
            some
              ({ negative := sign
                 significand := fraction.toNat
                 exponent := -149 } : Numerics.Dyadic)
