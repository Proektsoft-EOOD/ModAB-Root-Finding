      have hp : 0 < 2 ^ shift := Nat.pow_pos (by decide)
      have hlow : n % 2 ^ shift < 2 ^ shift := Nat.mod_lt n hp
      have hmod := Nat.mod_pow_succ (x := n) (b := 2) (k := shift)
