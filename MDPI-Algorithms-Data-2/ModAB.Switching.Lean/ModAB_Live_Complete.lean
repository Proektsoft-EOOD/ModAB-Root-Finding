  rw [binary64_guard_value]
  simp only [decision]
  split_ifs <;> simp_all

theorem decision_no_switch_iff (g : ℝ) : decision g = 2 ↔ g < -(32*binary64Epsilon) := by
  have he := binary64Epsilon_pos
  rw [binary64_guard_value]
  simp only [decision]
  split_ifs <;> simp_all <;> linarith

