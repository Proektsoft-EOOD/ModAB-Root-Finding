    ``ModAB.Binary64.round_quarter,
    ``ModAB.Binary64.round_neg_exact,
    ``ModAB.Binary64.round_neg_one,
    ``ModAB.Binary64.round_neg_two,
    ``ModAB.Binary64.round_neg_half,
    ``ModAB.Binary64.round_interval,
    ``ModAB.Binary64.round_abs_le_one,
    ``ModAB.Binary64.round_abs_le_two,
    ``ModAB.Binary64.round_error,
