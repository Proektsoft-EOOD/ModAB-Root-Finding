    ``ModAB.Source.binary64_certified_no_switch,
    ``ModAB.Source.binary64_margin_guarantees,
    ``ModAB.Source.guardWord_valid,
    ``ModAB.Source.guardWord_value,
    ``ModAB.Source.decisionWord_refines,
    ``ModAB.Source.executable_switch_sound,
    ``ModAB.Source.executable_no_switch_sound,
    ``ModAB.IEEE64.one_valid,
    ``ModAB.IEEE64.one_value,
    ``ModAB.IEEE64.two_valid,
    ``ModAB.IEEE64.two_value,
    ``ModAB.IEEE64.abs_value,
    ``ModAB.IEEE64.min_valid,
    ``ModAB.IEEE64.max_valid,
    ``ModAB.IEEE64.expression_refines,
    ``ModAB.IEEE64.descriptor_round,
