  let env ← getEnv
  let authored := names.foldl (fun acc n => acc.insert n) ({} : NameSet)
  for name in names do
    let info ← getConstInfo name
    let mut refs : NameSet := {}
    for n in directRefs info do
      for r in (authoredRefs env authored (({} : NameSet).insert name) n).toArray do
        refs := refs.insert r
    let axioms ← Lean.collectAxioms name
    let row := Json.mkObj [("name",toJson name.toString),
      ("dependencies",toJson ((refs.toArray.qsort Name.lt).map Name.toString)),
      ("axioms",toJson (axioms.map Name.toString))]
    liftIO (IO.println row.compress)
